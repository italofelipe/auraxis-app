<?xml version="1.0" encoding="utf-8"?>
<!--
  Auraxis app — Android network security config.

  Baseline:
  - Cleartext traffic blocked by default. The whole app must speak HTTPS.
  - System trust anchors only. No user-installed CAs honored.
  - api.auraxis.com.br is pinned to two CA keys from the production
    chain (Let's Encrypt YE2 + ISRG Root YE). Avoid leaf pins: the leaf
    rotates every 90 days and caused the 2026-07-24 login outage.
    See docs/runbooks/ssl-pinning-rotation.md before rotating.
-->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="false">api.auraxis.com.br</domain>
        <pin-set expiration="2028-08-01">
            <pin digest="SHA-256">s/tdAOmUzd8syaTuqfgGvFcn6DzA5Cmb+Vby1ST+U3Y=</pin>
            <pin digest="SHA-256">sCkq5UWXjg+7mKu9lMhhYF5bGLsy7VI/UNW3tccdR7w=</pin>
        </pin-set>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
