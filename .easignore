# Keep this file as a strict superset of .gitignore. EAS uses .easignore
# instead of .gitignore when both exist.

# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native builds generated by Expo prebuild
android/
ios/

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Logs and reports
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
audit.json
coverage/
reports/

# TypeScript
*.tsbuildinfo

# Design assets injected locally
designs/

# Native E2E sources and reports are not part of the runtime bundle
.maestro/
.maestro/reports/
e2e/

# Unit-test-only sources
__tests__/
__mocks__/

# Documentation and local agent context
docs/
.context/
.husky/

# Local worktrees and mutation artifacts
_worktrees/
repos/
.stryker-tmp/
reports/mutation/

# iCloud Drive / Finder duplicates
* 2
* 2.*
* 3
* 3.*

# Store credentials
*.p8
AuthKey_*.p8
gen-lang-client-*.json
*service-account*.json
*.keystore
